# Local dev only. Vite loads this for `vite dev` and NEVER for `vite build`, so it
# cannot leak into a deployed bundle.
#
# The local control-plane runs with AUTH_DISABLED=true, so the SPA must not demand a
# login. Auth is required by DEFAULT (see AUTH_REQUIRED in src/App.tsx) precisely so a
# production build that forgets its env vars fails safe with a login screen instead of
# silently shipping a console anyone can use.
VITE_AUTH_DISABLED=true
